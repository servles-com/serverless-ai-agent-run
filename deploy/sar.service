# SAR API proxy in front of the configured execution backend.
# Install: useradd --system --home /var/lib/sar sar; cp deploy/sar.service /etc/systemd/system/;
#          cp .env.example /opt/sar/.env (fill in, chmod 600, chown sar); systemctl enable --now sar
[Unit]
Description=Serverless AI Agent Run (execution API proxy)
After=network-online.target assist-agent.service
Wants=network-online.target

[Service]
Type=simple
User=sar
Group=sar
WorkingDirectory=/opt/sar
EnvironmentFile=/opt/sar/.env
ExecStart=/usr/bin/node src/server.ts
Restart=on-failure
RestartSec=5
# Run dirs live in /var/lib/sar (SAR_DATA_DIR); everything else is read-only.
StateDirectory=sar
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target

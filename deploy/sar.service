[Unit]
Description=serverless-ai-agent-run execution API
After=docker.service network-online.target
Requires=docker.service

[Service]
User=sar
Group=sar
EnvironmentFile=/etc/sar/sar.env
# SAR_GITHUB_PUSH_TOKEN + SAR_PR_REPOS for host-side PRs. Host-only: never passed to rooms.
EnvironmentFile=-/etc/sar/github-push.env
WorkingDirectory=/opt/sar
ExecStart=/usr/bin/node src/server.ts
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

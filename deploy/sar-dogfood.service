[Unit]
Description=serverless-ai-agent-run: dogfood batch against free models
After=sar.service

[Service]
Type=oneshot
User=sar
EnvironmentFile=/etc/sar/sar.env
# GITHUB_TOKEN here lets `gh` file dogfood issues
EnvironmentFile=-/etc/sar/secrets.env
WorkingDirectory=/opt/sar
ExecStart=/usr/bin/node scripts/dogfood-free-models.ts
ExecStartPost=-/usr/bin/node scripts/dogfood-file-issues.ts

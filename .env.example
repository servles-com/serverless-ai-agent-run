# SAR config. On the machine: /opt/sar/.env (systemd EnvironmentFile, chmod 600, owner sar).
# Locally: `set -a; . ./.env; set +a; npm start`.

# API for clients (pr-auto-fix, CLI): Authorization: Bearer $SAR_API_TOKEN
SAR_API_TOKEN=change-me
SAR_HOST=127.0.0.1
SAR_PORT=8787
SAR_DATA_DIR=/var/lib/sar

# Execution backend: trained-assist-agent on the same machine.
SAR_AGENT_URL=http://127.0.0.1:8080
# = WEB_VERIFY_SECRET on trained-assist-agent (or its AGENT_SECRET when WEB_VERIFY_SECRET is unset).
SAR_AGENT_SECRET=change-me
# trained-assist profile the runs belong to; it decides engine, model and credentials.
SAR_AGENT_PROFILE=sar-proxy

# Runs in flight at once; default limits when a request sets none.
SAR_MAX_ROOMS=2
SAR_DEFAULT_TIMEOUT_S=900
SAR_DEFAULT_IDLE_TIMEOUT_S=300

SAR_RETENTION_HOURS=72
# One webhook POST attempt, ms.
SAR_WEBHOOK_TIMEOUT=30000

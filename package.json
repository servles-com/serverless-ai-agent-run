{
  "name": "serverless-ai-agent-run",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": { "sar": "cli/sar.ts" },
  "description": "AI-agent runs behind an HTTP API with webhooks, executed by trained-assist-agent",
  "engines": { "node": ">=23.6" },
  "scripts": {
    "start": "node src/server.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test tests/unit/*.test.ts",
    "sar": "node cli/sar.ts",
    "dogfood": "node scripts/dogfood-free-models.ts",
    "lint": "eslint .",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/failures.ts --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=90 tests/unit/*.test.ts",
    "ci:guards": "node scripts/ci/run.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.1"
  }
}
